venv

# VCS and meta
.git
.github
.claude

# Ignore all node_modules everywhere to keep context slim
node_modules
**/node_modules

# Python caches and test artifacts
**/__pycache__
**/.pytest_cache
*.pyc
*.pyo
*.pyd

# Logs
*.log

# Large/unnecessary backend dirs

# macOS and editor junk
**/.DS_Store
.idea
.vscode

# Ignore all Next.js build artifacts entirely
.next
**/.next
web-client/.next
web-client/.next/cache
web-client/.next/trace
web-client/.turbo
web-client/.vercel
web-client/.cache
web-client/dist
web-client/out

# PIDs and generated artifacts
doorman.pid

# Docs and ops not needed in image
user-docs
load-tests
ops

# Local env and production env files
web-client/.env.local
.env
.env.*
!.env.example

# Rust build artifacts
target
gateway-rs/target
release-evidence

# Regenerated by local TypeScript/Next builds; excluding them keeps the image ID
# stable between the system E2E and release builds of the same source.
**/*.tsbuildinfo
web-client/next-env.d.ts
